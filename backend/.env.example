# ============================================================
# LifeGrid Backend Environment Variables Example
# ============================================================

# Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Configuration (Local instance / Replica Set)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=lifegrid_db

# Security & JWT
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq AI Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_CHAT=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_WHISPER=whisper-large-v3
