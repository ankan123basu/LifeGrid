# ============================================================
# LifeGrid – .gitignore
# Python backend + Next.js frontend monorepo
# ============================================================

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
.Python
pip-log.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.log
*.pot

# ─── Node / Next.js ──────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# ─── Secrets & environment files ─────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is intentionally NOT ignored – it is committed.

# ─── Uploads / generated assets ──────────────────────────────
uploads/
certificates/
exports/

# ─── OS artifacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ─── IDEs ─────────────────────────────────────────────────────
.vscode/settings.json
.idea/

# ─── MongoDB local data ───────────────────────────────────────
data/db/
mongod.log

# ─── Test / coverage artefacts ───────────────────────────────
htmlcov/
junit.xml

# ─── Misc ─────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
